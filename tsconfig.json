{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "lib": ["DOM", "ES2020"],
    "outDir": "src/main/webapp/js",
    "rootDir": "src/main/webapp/ts",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": false,
    "removeComments": true,
    "newLine": "lf"
  },
  "include": ["src/main/webapp/ts/**/*.ts"]
}
